# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth (shared by every provider) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical app URL. Required in production.
AUTH_URL=http://localhost:3000
# Set to true when running behind a trusted reverse proxy.
AUTH_TRUST_HOST=true

# --- Google OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Magic link (passwordless email) ---
# Resend API key with send permission (https://resend.com/api-keys).
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Quotient <noreply@quotient.dev>".
# Defaults to Resend's onboarding sender, which only delivers to your own inbox.
EMAIL_FROM=
# Lifetime of a magic link in minutes (defaults to 15, capped at 60).
MAGIC_LINK_EXPIRY_MINUTES=15

# --- Database ---
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# --- Redis/Upstash (for distributed rate limiting and caching) ---
# Required for serverless environments (Vercel, etc.) to share state across instances.
# Get these from your Upstash dashboard: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative: Use standard Redis URL if you have a self-hosted Redis instance
REDIS_URL=
