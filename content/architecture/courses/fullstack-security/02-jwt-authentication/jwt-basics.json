  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "**JWT Basics**\n\nJWT (JSON Web Token) is a compact, URL-safe token format for securely transmitting information between parties."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "JWT Structure"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Header: algorithm and token type",
          "Payload: claims/statements about the user",
          "Signature: verifies the token is authentic"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "JWT Structure",
        "content": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
        "language": "text"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Claims"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Registered claims: iss, sub, aud, exp, iat, jti",
          "Public claims: custom names",
          "Private claims: custom claims between parties"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "JWT vs Session Cookies"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "JWT: stateless, scalable, works across domains",
          "Session: stateful, simpler, automatic expiration",
          "JWT: larger payload, harder to revoke",
          "Session: smaller, easy server-side revocation"
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "JWT = Header.Payload.Signature",
          "Stateless authentication",
          "Claims contain user info",
          "Choose based on app requirements"
        ],
        "takeaway": "JWTs enable stateless authentication but require careful handling for security."
      }
    }
  ],
