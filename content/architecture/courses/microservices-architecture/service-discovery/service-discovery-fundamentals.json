    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Services need discovery because instances are dynamic",
          "Registry tracks available instances",
          "Client-side and server-side are the two main patterns"
        ],
        "takeaway": "Service discovery decouples services from hardcoded addresses."
      }
    }
