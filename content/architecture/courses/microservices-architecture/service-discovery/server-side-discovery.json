    {
      "type": "paragraph",
      "data": {
        "text": "In server-side discovery, the client makes a request to a load balancer, which queries the registry and forwards the request to an available instance."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Server-Side Discovery",
            "definition": "A load balancer queries the registry and routes requests."
          },
          {
            "term": "Load Balancer",
            "definition": "A proxy that distributes requests to service instances."
          },
          {
            "term": "Reverse Proxy",
            "definition": "A server that forwards requests to backend services."
          },
          {
            "term": "Sidecar Proxy",
            "definition": "A proxy deployed alongside a service, like Envoy."
          }
        ]
      }
    },
    {
      "type": "heading",
