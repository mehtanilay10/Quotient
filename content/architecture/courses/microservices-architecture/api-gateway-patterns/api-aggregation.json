  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "API aggregation combines responses from multiple services into a single response. This reduces chattiness between client and services."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "API Aggregation",
            "definition": "Combining data from multiple services into one response."
          },
          {
            "term": "Composition",
            "definition": "Building a response from multiple service calls."
          },
          {
            "term": "Chattiness",
            "definition": "Excessive back-and-forth between client and services."
          },
          {
            "term": "Parallel Aggregation",
            "definition": "Calling multiple services in parallel."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Why Aggregate"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Reduce client chattiness",
          "Improve performance with parallel calls",
          "Simplify client logic",
          "Tailor responses to client needs"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Aggregation Patterns"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Pattern", "Description", "Latency"],
        "rows": [
          ["Sequential", "Call services one after another", "Sum of all"],
          ["Parallel", "Call services concurrently", "Max of all"],
          ["Partial", "Return available data, fill in later", "Lowest"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Parallel Aggregation"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Parallel aggregation calls multiple services concurrently and combines results. This reduces latency to the slowest service rather than the sum."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Error Handling"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Return partial results on failure",
          "Use fallbacks for non-critical services",
          "Timeout per service call",
          "Circuit breakers for failing services"
        ]
      }
    },
    {
