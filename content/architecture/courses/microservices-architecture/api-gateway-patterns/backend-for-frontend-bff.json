  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "The Backend for Frontend (BFF) pattern creates a dedicated gateway for each client type (web, mobile, tablet). Each BFF is tailored to the needs of its client."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "BFF",
            "definition": "A backend specifically designed for a frontend client type."
          },
          {
            "term": "Client-Specific Gateway",
            "definition": "A gateway optimized for a particular client."
          },
          {
            "term": "Aggregation",
            "definition": "Combining data from multiple services into one response."
          },
          {
            "term": "Payload Optimization",
            "definition": "Tailoring response size and shape for a client."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Why BFF"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Different clients need different data",
          "Mobile needs compact payloads",
          "Web needs rich data",
          "Avoid over-fetching and chattiness"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "BFF vs Generic Gateway"
