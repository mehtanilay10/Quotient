  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Request routing directs requests to the right service or version. Different routing strategies support different deployment patterns like canary releases."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Path-Based Routing",
            "definition": "Routing based on the URL path."
          },
          {
            "term": "Header-Based Routing",
            "definition": "Routing based on HTTP headers."
          },
          {
            "term": "Canary Release",
            "definition": "Releasing a new version to a small subset of traffic."
          },
          {
            "term": "Blue-Green Deployment",
            "definition": "Deploying two environments and switching traffic."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Routing Strategies"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Strategy", "Description", "Use Case"],
        "rows": [
          ["Path-based", "Route by URL path", "/api/v1/catalog -> catalog service"],
          ["Header-based", "Route by HTTP header", "Version, tenant, or user routing"],
          ["Query-based", "Route by query param", "A/B testing"],
          ["Method-based", "Route by HTTP method", "Different handling for GET/POST"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Canary Releases"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Canary releases route a small percentage of traffic to a new version. If the new version performs well, traffic is gradually increased. If not, traffic is rolled back."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Blue-Green Deployment"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Blue-green deployment maintains two identical environments. The new version is deployed to the idle environment. Traffic is switched from blue to green when ready."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Traffic Splitting"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Percentage-based: 5% to new version",
          "Header-based: specific users to new version",
          "Cookie-based: sticky routing",
          "Region-based: geographic routing"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Architecture"
      }
    },
