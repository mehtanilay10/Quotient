        "text": "Best Practices"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Design for failure",
          "Keep services loosely coupled",
          "Monitor and observe everything",
          "Automate testing and deployment"
        ]
      }
    },
