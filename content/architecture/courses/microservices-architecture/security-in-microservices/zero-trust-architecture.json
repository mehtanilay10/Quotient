  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Zero trust means never trust, always verify. Every request is authenticated and authorized, regardless of network location."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Zero Trust",
            "definition": "A security model that never trusts, always verifies."
          },
          {
            "term": "Trust Boundary",
            "definition": "The edge where trust is established."
          },
          {
            "term": "Continuous Verification",
            "definition": "Verifying on every request, not just at login."
          },
          {
            "term": "Micro-Segmentation",
            "definition": "Dividing the network into small, isolated segments."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Zero Trust Principles"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Never trust, always verify",
          "Authenticate and authorize every request",
          "Assume breach (limit blast radius)",
          "Least privilege access",
          "Micro-segmentation"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Traditional vs Zero Trust"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Aspect", "Traditional", "Zero Trust"],
        "rows": [
          ["Network", "Trust internal network", "No implicit trust"],
          ["Access", "Once authenticated, broad access", "Per-request verification"],
          ["Segmentation", "Flat network", "Micro-segmented"],
          ["Assumption", "Inside is safe", "Assume breach"]
        ]
      }
    },
    {
