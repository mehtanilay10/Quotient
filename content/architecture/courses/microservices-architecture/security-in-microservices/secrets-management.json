    {
      "type": "paragraph",
      "data": {
        "text": "Secrets (passwords, API keys, certificates) must be managed securely. Never hardcode secrets. Use a secrets manager."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Secrets Manager",
            "definition": "A system for storing and accessing secrets securely."
          },
          {
            "term": "HashiCorp Vault",
            "definition": "A popular open-source secrets manager."
          },
          {
            "term": "Dynamic Secrets",
            "definition": "Secrets generated on-demand with short TTLs."
          },
          {
            "term": "Secret Rotation",
            "definition": "Regularly changing secrets to limit exposure."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Secrets Management Principles"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Never hardcode secrets",
          "Never commit secrets to source control",
          "Use a secrets manager",
          "Rotate secrets regularly",
          "Use dynamic secrets where possible"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Secrets Managers"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Manager", "Type", "Features"],
        "rows": [
          ["HashiCorp Vault", "Self-hosted", "Dynamic secrets, leasing, encryption"],
          ["AWS Secrets Manager", "Managed", "Rotation, KMS integration"],
          ["Azure Key Vault", "Managed", "Certificates, keys, secrets"],
