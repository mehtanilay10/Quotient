      "data": {
        "id": "msa-tcc",
        "caption": "TCC Pattern",
        "definition": "sequenceDiagram\n    participant C as Coordinator\n    participant A as Service A\n    participant B as Service B\n    C->>A: Try\n    C->>B: Try\n    A-->>C: Reserved\n    B-->>C: Reserved\n    alt All succeed\n        C->>A: Confirm\n        C->>B: Confirm\n    else Any fails\n        C->>A: Cancel\n        C->>B: Cancel\n    end"
      }
    },
