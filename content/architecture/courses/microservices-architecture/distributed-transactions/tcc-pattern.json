    {
      "type": "paragraph",
      "data": {
        "text": "TCC (Try-Confirm-Cancel) is a pattern for distributed transactions. It has three phases: Try (reserve resources), Confirm (commit), Cancel (release)."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "TCC",
            "definition": "Try-Confirm-Cancel pattern for distributed transactions."
          },
          {
            "term": "Try Phase",
            "definition": "Reserve resources and check constraints."
          },
          {
            "term": "Confirm Phase",
            "definition": "Commit the reserved resources."
          },
          {
            "term": "Cancel Phase",
            "definition": "Release reserved resources."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "TCC Phases"
      }
    },
