    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Distributed transactions are hard",
          "ACID across databases is impractical",
          "Use BASE and eventual consistency"
        ],
        "takeaway": "Distributed transactions require eventual consistency patterns."
      }
