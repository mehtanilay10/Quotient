  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "The saga pattern manages distributed transactions as a sequence of local transactions. Each step has a compensating transaction for rollback."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Saga",
            "definition": "A sequence of local transactions with compensations."
          },
          {
            "term": "Compensating Transaction",
            "definition": "A transaction that undoes a previous step."
          },
          {
            "term": "Local Transaction",
            "definition": "A transaction within a single service."
          },
          {
            "term": "Saga Orchestrator",
            "definition": "A service that coordinates the saga steps."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "How Saga Works"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Example: Order Creation"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Create order (Orders service)",
          "Charge payment (Payments service)",
          "Reserve inventory (Inventory service)",
          "If inventory fails: refund payment, cancel order"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Compensating Transactions"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Compensating transactions undo previous steps. They are not always exact reversals. For example, you cannot un-send an email, so you send a correction."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Saga Properties"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Property", "Description"],
        "rows": [
          ["Atomicity", "All steps complete or all compensated"],
          ["Consistency", "Eventual consistency"],
          ["Isolation", "No isolation (compensate instead)"],
          ["Durability", "Each local transaction is durable"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Architecture"
      }
    },
    {
      "type": "mermaid",
      "data": {
        "id": "msa-saga",
        "caption": "Saga Pattern Flow",
        "definition": "sequenceDiagram\n    participant O as Orchestrator\n    participant A as Orders\n    participant P as Payments\n    participant I as Inventory\n    O->>A: Create Order\n    A-->>O: Success\n    O->>P: Charge Payment\n    P-->>O: Success\n    O->>I: Reserve Inventory\n    I-->>O: Failed\n    O->>P: Refund Payment\n    O->>A: Cancel Order"
      }
    },
