  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Distributed tracing follows a request through multiple services. Each service adds a span to the trace, creating a complete picture."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Trace",
            "definition": "The end-to-end path of a request."
          },
          {
            "term": "Span",
            "definition": "A unit of work in a trace (one service call)."
          },
          {
            "term": "Span Context",
            "definition": "Metadata that connects spans (trace ID, span ID)."
          },
          {
            "term": "OpenTelemetry",
            "definition": "A vendor-neutral observability framework."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Trace Concepts"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Trace: the entire request path",
          "Span: a unit of work in a service",
          "Parent/child spans: nested operations",
          "Trace ID: unique identifier for the trace",
          "Span ID: unique identifier for a span"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "How It Works"
      }
    },
