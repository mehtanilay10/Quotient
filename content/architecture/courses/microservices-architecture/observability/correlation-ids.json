  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Correlation IDs trace a single request across multiple services. They are the backbone of distributed tracing and log correlation."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Correlation ID",
            "definition": "A unique ID that traces a request across services."
          },
          {
            "term": "Trace ID",
            "definition": "An OpenTelemetry trace identifier."
          },
          {
            "term": "Context Propagation",
            "definition": "Passing context (IDs, baggage) across service boundaries."
          },
          {
            "term": "W3C Trace Context",
            "definition": "A standard for propagating trace context."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Why Correlation IDs"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Trace a request across services",
          "Correlate logs across services",
          "Debug distributed issues",
          "Connect traces and logs"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Propagation"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "The correlation ID is generated at the entry point and propagated in HTTP headers and message headers to every downstream call."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Header Names"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Standard", "Header"],
        "rows": [
          ["W3C Trace Context", "traceparent"],
          ["B3 (Zipkin)", "X-B3-TraceId"],
          ["Custom", "X-Correlation-Id"],
          ["AWS X-Ray", "X-Amzn-Trace-Id"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Best Practices"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Generate at the edge (gateway)",
          "Propagate in all calls",
          "Include in all logs",
