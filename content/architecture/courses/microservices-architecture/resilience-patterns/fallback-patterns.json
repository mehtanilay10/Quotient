  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Fallback patterns provide alternative responses when a service fails. Graceful degradation keeps the system usable."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Fallback",
            "definition": "An alternative response when the primary fails."
          },
          {
            "term": "Graceful Degradation",
            "definition": "Continuing with reduced functionality."
          },
          {
            "term": "Cached Response",
            "definition": "Using cached data as a fallback."
          },
          {
            "term": "Default Response",
            "definition": "A static fallback response."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
