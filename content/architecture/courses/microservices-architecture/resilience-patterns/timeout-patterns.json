  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Timeouts limit how long a service call can take. Without timeouts, slow dependencies hang the entire system."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Timeout",
            "definition": "A limit on how long an operation can take."
          },
          {
            "term": "Connection Timeout",
            "definition": "Time to establish a connection."
          },
          {
            "term": "Read Timeout",
            "definition": "Time to wait for a response."
          },
          {
            "term": "Total Timeout",
            "definition": "Total time for the entire operation."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Timeout Types"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Type", "Description", "Typical Value"],
        "rows": [
          ["Connection", "Time to connect", "1-5 seconds"],
          ["Read", "Time to wait for response", "5-30 seconds"],
          ["Total", "Total operation time", "10-60 seconds"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Timeout Guidelines"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Set timeouts on all network calls",
          "Timeouts should be shorter than the caller timeout",
          "Consider the entire call chain",
          "Tune based on SLA and p99 latency"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Timeout Budget"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "A timeout budget allocates time across the call chain. If the user-facing request has 2 seconds, allocate time to each downstream call so the total fits within the budget."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Common Mistakes"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "No timeout (hangs forever)",
          "Infinite timeout",
          "Timeout longer than caller timeout",
          "Same timeout for all calls"
        ]
      }
    },
    {
      "type": "heading",
