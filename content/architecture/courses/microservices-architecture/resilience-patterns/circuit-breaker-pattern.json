  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "The circuit breaker pattern prevents calling a failing service. It has three states: closed, open, and half-open."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Concepts"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Circuit Breaker",
            "definition": "A pattern that prevents calling failing services."
          },
          {
            "term": "Closed State",
            "definition": "Normal operation, requests flow through."
          },
          {
            "term": "Open State",
            "definition": "Requests fail immediately without calling the service."
          },
          {
            "term": "Half-Open State",
            "definition": "Trial requests to test if the service recovered."
          }
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Circuit Breaker States"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["State", "Behavior", "Transition"],
        "rows": [
          ["Closed", "Requests flow, count failures", "Open after threshold"],
          ["Open", "Fail fast, no calls", "Half-open after timeout"],
          ["Half-Open", "Trial requests", "Closed if success, Open if fail"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
