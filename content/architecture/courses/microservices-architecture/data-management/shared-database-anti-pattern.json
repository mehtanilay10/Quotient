      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Best Practices"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Design for failure",
          "Keep services loosely coupled",
          "Monitor and observe everything",
          "Automate testing and deployment"
        ]
      }
    },
    {
      "type": "exercise",
      "data": {
        "title": "Exercise: Identify Anti-Pattern",
        "description": "Identify shared database usage in a system.",
        "steps": [
          "List all services and their tables",
          "Find tables accessed by multiple services",
          "Identify the owning service for each table",
          "Propose a fix for each shared table"
        ],
        "expectedOutcome": "A report of shared tables and ownership"
      }
    },
