    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Shared database creates tight coupling",
          "Services should own their data",
          "Access data through APIs"
        ],
        "takeaway": "Avoid shared databases; use service-owned databases with APIs."
