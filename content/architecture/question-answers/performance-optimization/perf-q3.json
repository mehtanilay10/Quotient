    {
      "type": "paragraph",
      "data": {
        "text": "**Question:** How do you reduce frontend load time?"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Short Answer"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Reduce bundle size with code splitting, compress assets, use CDNs, lazy load non-critical components, and cache with service workers."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Detailed Explanation"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "Code splitting: React.lazy and dynamic imports",
          "Tree shaking: remove unused exports",
          "Compression: Brotli or gzip on the server",
          "Caching: Cache-Control and service workers",
          "Images: WebP, responsive srcset, lazy loading"
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Example"
      }
