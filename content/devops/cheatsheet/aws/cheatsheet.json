  "blocks": [
    {
      "type": "heading",
      "data": { "level": 2, "text": "AWS Global Infrastructure" }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "AWS runs in regions worldwide. Each region contains multiple availability zones for high availability."
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Infrastructure Components",
        "items": [
          "Region: geographic area (e.g., us-east-1, eu-west-1)",
          "Availability Zone (AZ): isolated data center within a region",
          "Edge Location: CDN endpoint for CloudFront",
          "Local Zone: low-latency compute close to users",
          "Wavelength: 5G edge computing for telecom"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Compute" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "EC2 - Elastic Compute Cloud",
        "items": [
          "Virtual servers in the cloud",
          "Instance families: t/m/c/r/i/g/p",
          "Key pairs for SSH access",
          "Security Groups: virtual firewalls",
          "Elastic IP: static public IPv4",
          "Spot Instances: discounted spare capacity",
          "Auto Scaling: adjust capacity automatically"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Launch EC2 instance",
        "language": "bash",
        "code": "aws ec2 run-instances \\\n  --image-id ami-0c55b159cbfafe1f0 \\\n  --instance-type t3.micro \\\n  --key-name MyKeyPair \\\n  --security-group-ids sg-12345678 \\\n  --subnet-id subnet-12345678"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Serverless & Containers",
        "items": [
          "Lambda: run code without servers",
          "ECS: container orchestration",
          "EKS: managed Kubernetes",
          "Fargate: serverless containers",
          "Batch: run batch jobs",
          "Lightsail: simple VPS"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Storage" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "S3 - Simple Storage Service",
        "items": [
          "Object storage for files",
          "Storage classes: Standard, IA, Glacier",
          "Versioning, lifecycle, replication",
          "Bucket policies and ACLs",
          "Presigned URLs for temporary access"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Create S3 bucket and upload",
        "language": "bash",
        "code": "aws s3 mb s3://my-bucket\naws s3 cp file.txt s3://my-bucket/\naws s3 ls s3://my-bucket/"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Other Storage",
        "items": [
          "EBS: block storage for EC2",
          "EFS: managed NFS file system",
          "FSx: managed Windows/Lustre file systems",
          "Glacier: long-term archive"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Databases" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Relational",
        "items": [
          "RDS: managed MySQL, PostgreSQL, MariaDB, Oracle, SQL Server",
          "Aurora: MySQL/PostgreSQL compatible with 5x performance",
          "Aurora Serverless: auto-scaling database",
          "DynamoDB: fully managed NoSQL key-value"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Create RDS instance",
        "language": "bash",
        "code": "aws rds create-db-instance \\\n  --db-instance-identifier mydb \\\n  --db-instance-class db.t3.micro \\\n  --engine mysql \\\n  --master-username admin \\\n  --master-user-password MyPassword123"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Specialized Databases",
        "items": [
          "ElastiCache: Redis/Memcached",
          "Neptune: graph database",
          "DocumentDB: MongoDB-compatible",
          "Keyspaces: managed Cassandra",
          "Timestream: time-series data"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Networking" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "VPC - Virtual Private Cloud",
        "items": [
          "Isolated network environment",
          "Subnets: public and private",
          "Internet Gateway: connect to internet",
          "NAT Gateway: private subnet internet access",
          "Security Groups: instance-level firewall",
          "Network ACLs: subnet-level firewall",
          "VPC Peering: connect VPCs"
        ]
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Other Networking",
        "items": [
          "Route 53: DNS and domain management",
          "CloudFront: CDN for content delivery",
          "API Gateway: publish and manage APIs",
          "Direct Connect: dedicated network link",
          "VPN Gateway: site-to-site VPN",
          "PrivateLink: private access to services"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Security & Identity" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "IAM - Identity & Access Management",
        "items": [
          "Users: individual identities",
          "Groups: collections of users",
          "Roles: assumed by AWS services",
          "Policies: JSON permission documents",
          "MFA: multi-factor authentication",
          "Access Keys: programmatic access"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "IAM policy example",
        "language": "json",
        "code": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": \"arn:aws:s3:::my-bucket/*\"\n    }\n  ]\n}"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Other Security",
        "items": [
          "Organizations: manage multiple accounts",
          "CloudTrail: audit API calls",
          "Config: track resource configurations",
          "GuardDuty: threat detection",
          "Inspector: vulnerability scanning",
          "KMS: encryption key management",
          "Secrets Manager: rotate and manage secrets",
          "WAF: web application firewall",
          "Shield: DDoS protection"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Messaging & Integration" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Event & Messaging Services",
        "items": [
          "SQS: message queuing",
          "SNS: pub/sub notifications",
          "EventBridge: event bus",
          "Kinesis: real-time streaming",
          "Step Functions: workflow orchestration"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "AI & Machine Learning" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "AI Services",
        "items": [
          "SageMaker: build, train, deploy ML models",
          "Bedrock: foundation models API",
          "Rekognition: image/video analysis",
          "Comprehend: NLP text analysis",
          "Transcribe: speech to text",
          "Polly: text to speech",
          "Textract: document text extraction",
          "Translate: language translation"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Developer Tools" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "CI/CD & IaC",
        "items": [
          "CodeCommit: Git repositories",
          "CodeBuild: build and test",
          "CodeDeploy: deploy applications",
          "CodePipeline: CI/CD orchestration",
          "CloudFormation: infrastructure as code",
          "CDK: define infrastructure in code"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Monitoring & Logging" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Observability Services",
        "items": [
          "CloudWatch: metrics, logs, alarms",
          "CloudTrail: API audit logs",
          "X-Ray: distributed tracing",
          "Health: AWS service health dashboard"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Common CLI Patterns" }
    },
    {
      "type": "example",
      "data": {
        "title": "AWS CLI essentials",
        "language": "bash",
        "code": "# Configure credentials\naws configure\n\n# List S3 buckets\naws s3 ls\n\n# List EC2 instances\naws ec2 describe-instances\n\n# Get caller identity\naws sts get-caller-identity\n\n# Deploy CloudFormation stack\naws cloudformation deploy \\\n  --template-file template.yaml \\\n  --stack-name my-stack \\\n  --capabilities CAPABILITY_NAMED_IAM"
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Shared Responsibility Model" }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "AWS secures the cloud infrastructure. You secure your data, applications, and access controls."
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "AWS Responsibility",
        "items": ["Physical data centers", "Hardware and network", "Global infrastructure"]
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Your Responsibility",
        "items": [
          "Data and encryption",
          "IAM and access management",
          "Operating system and applications",
          "Network configurations"
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "AWS regions contain multiple AZs for fault tolerance",
          "EC2 provides virtual servers; Lambda provides serverless functions",
          "S3 is object storage; EBS is block storage for EC2",
          "VPC is your isolated network in AWS",
          "IAM controls who can do what",
          "CloudFormation/CDK define infrastructure as code"
        ],
        "takeaway": "AWS offers 200+ services organized around compute, storage, databases, networking, security, and AI/ML."
      }
    }
  ],
