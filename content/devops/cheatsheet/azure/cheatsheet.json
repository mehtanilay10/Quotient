  "blocks": [
    {
      "type": "heading",
      "data": { "level": 2, "text": "Azure Global Infrastructure" }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Azure runs in regions worldwide. Each region contains availability zones for high availability."
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Infrastructure Components",
        "items": [
          "Region: geographic area (e.g., eastus, westeurope)",
          "Availability Zone: isolated data center within a region",
          "Edge Location: CDN endpoint for Front Door",
          "Region Pairs: paired regions for replication"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Compute" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Virtual Machines & App Service",
        "items": [
          "Virtual Machines: IaaS VMs",
          "Virtual Machine Scale Sets: auto-scaling VMs",
          "App Service: PaaS for web apps",
          "Deployment Slots: staging environments",
          "Functions: serverless event-driven code",
          "Container Instances: run containers without orchestration"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Create Azure VM",
        "language": "bash",
        "code": "az vm create \\\n  --resource-group MyRG \\\n  --name myVM \\\n  --image UbuntuLTS \\\n  --size Standard_B1s \\\n  --admin-username azureuser \\\n  --generate-ssh-keys"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Containers & Orchestration",
        "items": [
          "Container Registry (ACR): store container images",
          "Container Apps: serverless containers",
          "Kubernetes Service (AKS): managed Kubernetes",
          "Service Fabric: microservices orchestration"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Storage" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Blob Storage",
        "items": [
          "Block blobs: files, images, videos",
          "Append blobs: log files",
          "Page blobs: VHD disks",
          "Access tiers: Hot, Cool, Archive",
          "Lifecycle management policies"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Create storage account and upload blob",
        "language": "bash",
        "code": "az storage account create \\\n  --name mystorageaccount \\\n  --resource-group MyRG \\\n  --sku Standard_LRS\n\naz storage container create \\\n  --account-name mystorageaccount \\\n  --name mycontainer"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Other Storage",
        "items": [
          "Azure Files: SMB/NFS file shares",
          "Queue Storage: message queuing",
          "Table Storage: NoSQL key-value",
          "Disk Storage: managed disks for VMs",
          "Data Lake Storage: big data analytics"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Databases" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Relational Databases",
        "items": [
          "SQL Database: managed SQL Server",
          "Azure SQL: SQL Server in cloud",
          "Azure Database for MySQL",
          "Azure Database for PostgreSQL",
          "Cosmos DB: globally distributed NoSQL",
          "Azure SQL Managed Instance"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Create Azure SQL server",
        "language": "bash",
        "code": "az sql server create \\\n  --name myazuresql \\\n  --resource-group MyRG \\\n  --location eastus \\\n  --admin-user sqladmin \\\n  --admin-password MyPassword123"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Specialized Databases",
        "items": [
          "Cache for Redis: in-memory caching",
          "Database Migration Service: migrate databases",
          "Synapse Analytics: data warehouse",
          "Data Explorer: log analytics"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Networking" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Virtual Network (VNet)",
        "items": [
          "VNets: isolated network",
          "Subnets: segment VNet address space",
          "Network Security Groups: filter traffic",
          "Application Gateway: layer 7 load balancer",
          "Load Balancer: layer 4 load balancer",
          "Azure Firewall: managed firewall"
        ]
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Connectivity & DNS",
        "items": [
          "VPN Gateway: site-to-site VPN",
          "ExpressRoute: private fiber connection",
          "Private Link: private access to services",
          "DNS: domain name resolution",
          "Front Door: global load balancer and CDN",
          "Traffic Manager: DNS-based routing"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Identity & Access" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Microsoft Entra ID",
        "items": [
          "Tenants: dedicated Entra ID instances",
          "Users and Groups: identity management",
          "Enterprise Applications: SaaS apps",
          "App Registrations: application identities",
          "Service Principals: app credentials",
          "Managed Identities: no credentials needed"
        ]
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "RBAC & Security",
        "items": [
          "Role-Based Access Control (RBAC)",
          "Built-in roles: Owner, Contributor, Reader",
          "Custom roles: define permissions",
          "Key Vault: secrets, keys, certificates",
          "App Configuration: feature flags and config",
          "Defender: threat protection",
          "Sentinel: SIEM and analytics"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Messaging & Events" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Event-Driven Services",
        "items": [
          "Service Bus: enterprise messaging",
          "Event Grid: event routing",
          "Event Hubs: big data streaming",
          "Notification Hubs: push notifications"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "AI & Machine Learning" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Azure AI Services",
        "items": [
          "OpenAI Service: GPT-4, DALL-E, embeddings",
          "Cognitive Services: vision, speech, language",
          "Azure AI Search: search with vector and semantic",
          "Machine Learning: end-to-end ML platform",
          "Bot Service: conversational AI",
          "Form Recognizer: document extraction"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Developer Tools" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "DevOps & IaC",
        "items": [
          "DevOps: repos, pipelines, boards",
          "GitHub Actions: CI/CD automation",
          "Bicep: infrastructure as code DSL",
          "ARM Templates: JSON IaC",
          "Azure CLI: cross-platform CLI",
          "Cloud Shell: browser-based shell",
          "Portal: web management console"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Monitoring & Management" }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Observability",
        "items": [
          "Monitor: metrics, logs, alerts",
          "Application Insights: APM for apps",
          "Log Analytics: log query with KQL",
          "Service Health: Azure status",
          "Advisor: best practice recommendations"
        ]
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Common CLI Patterns" }
    },
    {
      "type": "example",
      "data": {
        "title": "Azure CLI essentials",
        "language": "bash",
        "code": "# Login\naz login\n\n# Create resource group\naz group create --name MyRG --location eastus\n\n# Create storage account\naz storage account create \\\n  --name mystorageaccount \\\n  --resource-group MyRG \\\n  --sku Standard_LRS\n\n# List resources in RG\naz resource list --resource-group MyRG"
      }
    },
    {
      "type": "heading",
      "data": { "level": 2, "text": "Resource Hierarchy" }
    },
    {
      "type": "paragraph",
      "data": { "text": "Azure organizes resources in a hierarchy for management and billing." }
    },
    {
      "type": "bullet-list",
      "data": {
        "title": "Hierarchy Levels",
        "items": [
          "Management Group: top-level container for multiple subscriptions",
          "Subscription: billing and access boundary",
          "Resource Group: container for resources",
          "Resource: individual service instance"
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Azure regions contain availability zones for fault tolerance",
          "VMs provide IaaS; App Service and Functions provide PaaS/serverless",
          "Blob Storage handles files; Cosmos DB handles NoSQL",
          "Entra ID manages identity; RBAC manages access",
          "Azure CLI is the primary cross-platform tool",
          "Bicep and ARM Templates define infrastructure as code"
        ],
        "takeaway": "Azure provides 200+ services across compute, storage, networking, identity, and AI/ML."
      }
    }
  ],
