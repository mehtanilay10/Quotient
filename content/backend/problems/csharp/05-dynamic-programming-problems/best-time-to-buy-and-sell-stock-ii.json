        "text": "Approach: Greedy (Sum All Positive Diffs)"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n) O(1)",
        "language": "csharp",
        "code": "public int MaxProfit2(int[] prices)\n{\n    int profit = 0;\n    for (int i = 1; i < prices.Length; i++)\n        if (prices[i] > prices[i - 1])\n            profit += prices[i] - prices[i - 1];\n    return profit;\n}"
      }
    },
