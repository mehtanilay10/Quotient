  "tags": ["csharp", "dynamic-programming", "recursion", "easy"],
  "blocks": [
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Problem Statement"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Compute F(n) where F(0)=0, F(1)=1, F(n)=F(n-1)+F(n-2)."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 1: Recursive"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(2^n)",
        "language": "csharp",
        "code": "public int Fib(int n)\n{\n    if (n <= 1) return n;\n    return Fib(n - 1) + Fib(n - 2);\n}"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 2: Tabulation"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n) O(n)",
        "language": "csharp",
        "code": "public int FibTab(int n)\n{\n    if (n <= 1) return n;\n    int[] dp = new int[n + 1];\n    dp[0] = 0; dp[1] = 1;\n    for (int i = 2; i <= n; i++) dp[i] = dp[i - 1] + dp[i - 2];\n    return dp[n];\n}"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 3: Space Optimized"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n) O(1)",
        "language": "csharp",
        "code": "public int Fib(int n)\n{\n    if (n <= 1) return n;\n    int a = 0, b = 1;\n    for (int i = 2; i <= n; i++)\n    {\n        int c = a + b; a = b; b = c;\n    }\n    return b;\n}"
      }
    },
    {
