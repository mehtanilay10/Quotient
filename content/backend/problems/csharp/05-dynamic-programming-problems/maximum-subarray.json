    {
      "type": "paragraph",
      "data": {
        "text": "Given `nums`, find the contiguous subarray with the largest sum."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: Kadane's Algorithm"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n) O(1)",
        "language": "csharp",
        "code": "public int MaxSubArray(int[] nums)\n{\n    int maxSum = nums[0], curr = nums[0];\n    for (int i = 1; i < nums.Length; i++)\n    {\n        curr = Math.Max(nums[i], curr + nums[i]);\n        maxSum = Math.Max(maxSum, curr);\n    }\n    return maxSum;\n}"
      }
    },
    {
