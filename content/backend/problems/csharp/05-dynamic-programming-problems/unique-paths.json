        "text": "Problem Statement"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Given m\u00d7n grid, count unique paths from (0,0) to (m-1,n-1)."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: Combinatorics"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(min(m,n))",
        "language": "csharp",
        "code": "public int UniquePaths(int m, int n)\n{\n    int smaller = Math.Min(m, n) - 1;\n    int total = m + n - 2;\n    long result = 1;\n    for (int i = 1; i <= smaller; i++)\n        result = result * (total - smaller + i) / i;\n    return (int)result;\n}"
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "title": "Approach Comparison",
        "cards": [
          {
            "title": "Combinatorics",
            "description": "C(m+n-2, m-1)",
            "pros": ["O(min(m,n))", "O(1) space"],
            "tags": ["O(min(m,n)) time", "O(1) space", "Recommended"]
          }
        ]
