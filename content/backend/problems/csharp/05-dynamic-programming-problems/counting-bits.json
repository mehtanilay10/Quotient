      "type": "paragraph",
      "data": {
        "text": "Given n, return array of number of 1's in binary representation of 0..n."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: DP Using Right Shift"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n)",
        "language": "csharp",
        "code": "public int[] CountBits(int n)\n{\n    int[] result = new int[n + 1];\n    for (int i = 1; i <= n; i++)\n        result[i] = result[i >> 1] + (i & 1);\n    return result;\n}"
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "title": "Approach Comparison",
        "cards": [
          {
            "title": "DP Right Shift",
            "description": "result[i] = result[i/2] + i%2",
            "pros": ["O(n) time"],
            "tags": ["O(n) time", "O(n) space", "Recommended"]
          }
        ]
      }
