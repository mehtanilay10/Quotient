    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: DP with Obstacle Check"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(m\u00b7n) O(n)",
        "language": "csharp",
        "code": "public int UniquePathsWithObstacles(int[][] grid)\n{\n    int m = grid.Length, n = grid[0].Length;\n    if (grid[0][0] == 1) return 0;\n    int[] dp = new int[n];\n    dp[0] = 1;\n    for (int i = 0; i < m; i++)\n    {\n        for (int j = 0; j < n; j++)\n        {\n            if (grid[i][j] == 1) dp[j] = 0;\n            else if (j > 0) dp[j] += dp[j - 1];\n        }\n    }\n    return dp[n - 1];\n}"
      }
    },
