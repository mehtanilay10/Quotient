    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: Track Min Price"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n) O(1)",
        "language": "csharp",
        "code": "public int MaxProfit(int[] prices)\n{\n    int minPrice = int.MaxValue;\n    int maxProfit = 0;\n    foreach (int price in prices)\n    {\n        minPrice = Math.Min(minPrice, price);\n        maxProfit = Math.Max(maxProfit, price - minPrice);\n    }\n    return maxProfit;\n}"
      }
    },
