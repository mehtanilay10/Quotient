    {
      "type": "paragraph",
      "data": {
        "text": "Given candidates and target, return the number of combinations summing to target."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: DP Tabulation"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(target \u00b7 n)",
        "language": "csharp",
        "code": "public int CombinationSum4(int[] nums, int target)\n{\n    int[] dp = new int[target + 1];\n    dp[0] = 1;\n    for (int i = 1; i <= target; i++)\n        foreach (int num in nums)\n            if (i >= num)\n                dp[i] += dp[i - num];\n    return dp[target];\n}"
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "title": "Approach Comparison",
        "cards": [
