  "title": "Reverse Linked List",
  "description": "Reverse a singly linked list iteratively and recursively.",
  "order": 1,
  "difficulty": "easy",
  "estimatedMinutes": 12,
  "tags": ["csharp", "linked-list", "pointers", "easy"],
  "blocks": [
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Problem Statement"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Given `head`, reverse the list and return the new head."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 1: Iterative"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Iterative O(n) O(1)",
        "language": "csharp",
        "code": "public ListNode? ReverseList(ListNode? head)\n{\n    ListNode? prev = null;\n    while (head != null)\n    {\n        ListNode? next = head.Next;\n        head.Next = prev;\n        prev = head;\n        head = next;\n    }\n    return prev;\n}"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 2: Recursive"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Recursive O(n) O(n)",
        "language": "csharp",
        "code": "public ListNode? ReverseListRecursive(ListNode? head)\n{\n    if (head == null || head.Next == null) return head;\n    ListNode? newHead = ReverseListRecursive(head.Next);\n    head.Next.Next = head;\n    head.Next = null;\n    return newHead;\n}"
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "title": "Approach Comparison",
        "cards": [
          {
            "title": "Iterative",
            "description": "Three-pointer in-place",
            "pros": ["O(1) space", "No stack risk"],
            "cons": ["Pointer tracking"],
            "tags": ["O(n) time", "O(1) space", "Recommended"]
          },
          {
            "title": "Recursive",
            "description": "Unwind call stack to reverse",
            "pros": ["Elegant"],
            "cons": ["O(n) stack"],
            "tags": ["O(n) time", "O(n) space"]
          }
        ]
      }
    }
