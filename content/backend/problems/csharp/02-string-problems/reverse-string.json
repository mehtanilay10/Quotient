  "blocks": [
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Problem Statement"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Given a char array `s`, reverse it in-place with O(1) extra memory."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 3,
        "text": "Example"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "**Input:** `s = ['h','e','l','l','o']`\n\n**Output:** `['o','l','l','e','h']`"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 1: Built-in"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Array.Reverse O(n)",
        "language": "csharp",
        "code": "public void ReverseStringBuilt(char[] s)\n{\n    Array.Reverse(s);\n}"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 2: Two-Pointer Swap"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Two-Pointer O(n) O(1)",
        "language": "csharp",
        "code": "public void ReverseString(char[] s)\n{\n    int left = 0, right = s.Length - 1;\n    while (left < right)\n    {\n        (s[left], s[right]) = (s[right], s[left]);\n        left++; right--;\n    }\n}"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "What improved?",
        "text": "Tuple swap `(a,b)=(b,a)` removes temp variable. Same O(n) time, O(1) space."
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "title": "Approach Comparison",
        "cards": [
          {
            "title": "Built-in",
            "description": "Array.Reverse",
            "pros": ["Shortest", "Optimized"],
            "cons": ["Doesn't demonstrate pattern"],
            "tags": ["O(n) time", "O(1) space"]
          },
          {
            "title": "Two-Pointer",
            "description": "Manual left/right swap",
            "pros": ["Interview standard", "O(1) space"],
            "cons": ["More code"],
