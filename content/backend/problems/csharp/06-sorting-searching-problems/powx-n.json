    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach: Fast Exponentiation"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(log n)",
        "language": "csharp",
        "code": "public double MyPow(double x, int n)\n{\n    long exp = n;\n    if (exp < 0)\n    {\n        x = 1 / x;\n        exp = -exp;\n    }\n    double result = 1;\n    while (exp > 0)\n    {\n        if ((exp & 1) == 1) result *= x;\n        x *= x;\n        exp >>= 1;\n    }\n    return result;\n}"
      }
    },
