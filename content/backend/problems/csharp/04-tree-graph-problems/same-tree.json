      "data": {
        "title": "O(n) O(h)",
        "language": "csharp",
        "code": "public bool IsSameTree(TreeNode? p, TreeNode? q)\n{\n    if (p == null && q == null) return true;\n    if (p == null || q == null || p.Val != q.Val) return false;\n    return IsSameTree(p.Left, q.Left) && IsSameTree(p.Right, q.Right);\n}"
      }
