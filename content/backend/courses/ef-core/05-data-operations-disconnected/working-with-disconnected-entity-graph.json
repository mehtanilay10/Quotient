{
  "id": "lesson-ef-017",
  "slug": "working-with-disconnected-entity-graph",
  "moduleSlug": "data-operations-disconnected",
  "title": "Working with Disconnected Entity Graph",
  "description": "Learn how different methods handle EntityState in disconnected entity graphs.",
  "order": 4,
  "difficulty": "intermediate",
  "estimatedMinutes": 35,
  "tags": ["ef-core", "entity-graph", "disconnected", "attach", "update", "remove"],
  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Different EF Core methods behave differently when handling disconnected entity graphs. Understanding these behaviors is crucial for correct data operations."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Attach() Behavior"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Sets Added state to root entity, Unchanged for children with keys, Added for children without keys:"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Attach() with State",
          "Root with Key",
          "Root Empty Key",
          "Child with Key",
          "Child Empty Key"
        ],
        "rows": [
          ["Added", "Added", "Added", "Unchanged", "Added"],
          ["Modified", "Modified", "Exception", "Unchanged", "Added"],
          ["Deleted", "Deleted", "Exception", "Unchanged", "Added"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Entry() Behavior"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Only affects the root entity, ignores all child entities:"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Entry() with State", "Root Entity", "Child Entities"],
        "rows": [
          ["Added", "Added", "Ignored"],
          ["Modified", "Modified", "Ignored"],
          ["Deleted", "Deleted", "Ignored"]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Add() Behavior"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Sets Added state to all entities in the graph regardless of key values:"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": ["Method", "Root Entity", "Child Entities"],
        "rows": [["Add()", "Added", "Added"]]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Update() Behavior"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Sets Modified for entities with keys, Added for entities without keys:"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Method",
          "Root with Key",
          "Root Empty Key",
          "Child with Key",
          "Child Empty Key"
        ],
        "rows": [["Update()", "Modified", "Added", "Modified", "Added"]]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Remove() Behavior"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Sets Deleted to root entity, Unchanged for children with keys, Added for children without keys:"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Method",
          "Root with Key",
          "Root Empty Key",
          "Child with Key",
          "Child Empty Key"
        ],
        "rows": [["Remove()", "Deleted", "Exception", "Unchanged", "Added"]]
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "warning",
        "title": "Be Careful",
        "text": "These methods have different behaviors on entity graphs. Choose the appropriate method based on your requirements."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Attach() sets state based on key values for children",
          "Entry() only affects root entity",
          "Add() sets Added for all entities",
          "Update() sets Modified/Added based on keys",
          "Remove() sets Deleted for root only"
        ],
        "takeaway": "Continue to learn about change tracking."
      }
    }
  ],
  "relatedLessons": ["delete-data-disconnected-scenario", "tracking-changes-of-entities"],
  "courseSlug": "ef-core"
}
