  "title": "Entity Framework Extensions Performance",
  "description": "Learn bulk operations with Z.EntityFrameworkCore.Extensions library.",
  "order": 1,
  "difficulty": "advanced",
  "estimatedMinutes": 30,
  "tags": ["ef-core", "bulk-operations", "entity-framework-extensions", "performance"],
  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Working with large datasets using standard EF Core SaveChanges() can be a performance bottleneck. Entity Framework Extensions library provides bulk operations for inserts, updates, deletes, and merges."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Installation"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Install Package",
        "content": "Installing Z.EntityFrameworkCore.Extensions.EFCore",
        "language": "powershell",
        "code": "Install-Package Z.EntityFrameworkCore.Extensions.EFCore"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "BulkInsert"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "BulkInsert Example",
        "content": "Inserting large number of records",
        "language": "csharp",
        "code": "var records = csv.GetRecords<Survey>();\ncontext.BulkInsert(records, options => options.InsertKeepIdentity = true);\n\n// For maximum speed\ncontext.BulkInsertOptimized(records, options => options.InsertKeepIdentity = true);"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "BulkMerge (Upsert)"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "BulkMerge automatically decides whether to insert or update based on key values:"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "BulkMerge Example",
        "content": "Upsert operation with BulkMerge",
        "language": "csharp",
        "code": "context.BulkMerge(updateEmployee);"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "BulkDelete"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "BulkDelete Example",
        "content": "Deleting large number of records",
        "language": "csharp",
        "code": "context.BulkDelete(deleteEmployee);"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "info",
        "title": "Performance Benefits",
        "text": "Entity Framework Extensions can reduce execution times by up to 95% compared to standard SaveChanges() for large datasets."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "BulkInsert for fast inserts",
          "BulkMerge for upsert operations",
          "BulkDelete for mass deletion",
          "Up to 95% performance improvement"
        ],
        "takeaway": "Continue to learn about bulk insert strategies."
      }
    }
