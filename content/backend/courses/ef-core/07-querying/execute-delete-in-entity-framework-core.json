{
  "id": "lesson-ef-023",
  "slug": "execute-delete-in-entity-framework-core",
  "moduleSlug": "querying",
  "title": "Execute Delete in Entity Framework Core",
  "description": "Learn efficient bulk delete operations with ExecuteDelete (EF Core 7+).",
  "order": 3,
  "difficulty": "intermediate",
  "estimatedMinutes": 20,
  "tags": ["ef-core", "execute-delete", "bulk-operations", "performance"],
  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "`ExecuteDelete` was introduced in EF Core 7 to efficiently delete entities **without loading them into the context**."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Before: RemoveRange + SaveChanges"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Old Approach",
        "content": "Loading entities before deletion",
        "language": "csharp",
        "code": "var q = context.TestEntities.Where(x => !x.IsActive);\ncontext.TestEntities.RemoveRange(q);\ncontext.SaveChanges();"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Now: ExecuteDelete"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "ExecuteDelete",
        "content": "Direct delete without loading entities",
        "language": "csharp",
        "code": "context.TestEntities\n    .Where(x => !x.IsActive)\n    .ExecuteDelete();"
      }
    },
    {
      "type": "mermaid",
      "data": {
        "id": "execute-delete-comparison",
        "caption": "ExecuteDelete vs RemoveRange comparison",
        "definition": "graph TB\n    A[RemoveRange] --> B[SELECT]\n    B --> C[Load Entities]\n    C --> D[Track Changes]\n    D --> E[DELETE]\n    F[ExecuteDelete] --> G[Single DELETE]"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "info",
        "title": "Performance Benefits",
        "text": "ExecuteDelete is faster and uses less memory since entities are never loaded into memory. The more rows you delete, the greater the performance gain."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "ExecuteDelete introduced in EF Core 7",
          "No entities loaded into memory",
          "Single DELETE statement executed",
          "Much faster than RemoveRange for bulk deletes"
        ],
        "takeaway": "Continue to learn about ExecuteUpdate."
      }
    }
  ],
  "relatedLessons": ["execute-raw-sql-queries", "execute-update-in-entity-framework-core"],
  "courseSlug": "ef-core"
}
