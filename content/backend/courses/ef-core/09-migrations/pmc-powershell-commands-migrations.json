          ["Update-Database", "Updates database to specified migration"],
          ["Script-Migration", "Generates SQL script from migrations"],
          ["Scaffold-DbContext", "Generates DbContext from existing database"],
          ["Get-DbContext", "Gets information about DbContext"],
          ["Drop-Database", "Drops the database"]
