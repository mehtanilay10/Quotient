  "blocks": [
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "SQL Server RAISERROR Statement"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "The RAISERROR statement allows you to generate your own error messages and return them to the application. If developing a new application, consider using THROW instead."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "RAISERROR Syntax"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "RAISERROR with message text",
        "content": "Raises a custom error message.",
        "language": "sql",
        "code": "RAISERROR ( { message_id | message_text | @local_variable }\n    { ,severity ,state }\n    [ ,argument [ ,...n ] ] )\n    [ WITH option [ ,...n ] ];"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Severity Levels"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": ["0–10: Informational messages", "11–18: Errors", "19–25: Fatal errors"]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "RAISERROR Example"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "RAISERROR with TRY CATCH",
        "content": "Raises and catches a custom error.",
        "language": "sql",
        "code": "BEGIN TRY\n    RAISERROR('Error occurred in the TRY block.', 17, 1);\nEND TRY\nBEGIN CATCH\n    SELECT\n        ERROR_MESSAGE() AS ErrorMessage,\n        ERROR_SEVERITY() AS ErrorSeverity;\nEND CATCH;"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Key Takeaways"
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "RAISERROR Key Points",
        "points": [
          "RAISERROR generates user-defined error messages.",
          "Use THROW for new applications instead of RAISERROR.",
          "Severity levels range from 0 (informational) to 25 (fatal).",
          "RAISERROR supports printf-style formatting in messages."
        ]
      }
    }
  ],
